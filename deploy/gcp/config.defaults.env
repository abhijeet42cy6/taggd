# Shared GCP defaults for tgddata (source from repo root: source deploy/gcp/config.defaults.env)
export GCP_PROJECT="${GCP_PROJECT:-taggd-491107}"
export GCP_REGION="${GCP_REGION:-asia-south1}"
export GCP_LOCATION="${GCP_LOCATION:-asia-south1}"

export CLOUDSQL_INSTANCE="${CLOUDSQL_INSTANCE:-tgddata-pg-prod}"
export CLOUDSQL_CONNECTION_NAME="${CLOUDSQL_CONNECTION_NAME:-taggd-491107:asia-south1:tgddata-pg-prod}"

export GCS_UPLOADS_BUCKET="${GCS_UPLOADS_BUCKET:-taggd-tgddata-prod-uploads}"
export GCS_WEB_BUCKET="${GCS_WEB_BUCKET:-taggd-tgddata-prod-web}"

export CLOUD_RUN_SERVICE_API="${CLOUD_RUN_SERVICE_API:-tgddata-api}"
export CLOUD_RUN_SERVICE_WEB="${CLOUD_RUN_SERVICE_WEB:-tgddata-web}"

export RUNTIME_SA_NAME="${RUNTIME_SA_NAME:-tgddata-runtime}"
export RUNTIME_SA_EMAIL="${RUNTIME_SA_EMAIL:-tgddata-runtime@${GCP_PROJECT}.iam.gserviceaccount.com}"

export VPC_CONNECTOR="${VPC_CONNECTOR:-tgddata-run-connector}"
export VPC_CONNECTOR_CIDR="${VPC_CONNECTOR_CIDR:-10.8.208.0/28}"

export AR_REPO="${AR_REPO:-tgddata}"
export IMAGE_API="${IMAGE_API:-${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT}/${AR_REPO}/api}"
export IMAGE_WEB="${IMAGE_WEB:-${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT}/${AR_REPO}/web}"

export STORAGE_BACKEND="${STORAGE_BACKEND:-gcs}"
export STORAGE_PREFIX="${STORAGE_PREFIX:-tgddata}"

# Production UI origins (comma-separated)
export CORS_ALLOW_ORIGINS="${CORS_ALLOW_ORIGINS:-https://taggd.aparatus.in,https://storage.googleapis.com}"

export PUBLIC_APP_URL="${PUBLIC_APP_URL:-https://taggd.aparatus.in}"
export APP_ENV="${APP_ENV:-production}"
