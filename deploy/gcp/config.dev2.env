# dev2 environment — fully isolated from prod and tgddata-pg-prod-dev.
# Source from deploy scripts: . deploy/gcp/config.dev2.env

export GCP_PROJECT="${GCP_PROJECT:-taggd-491107}"
export GCP_REGION="${GCP_REGION:-asia-south1}"
export GCP_LOCATION="${GCP_LOCATION:-asia-south1}"

# New Cloud SQL instance for dev2 only
export CLOUDSQL_INSTANCE="${CLOUDSQL_INSTANCE:-tgddata-pg-dev2}"
export CLOUDSQL_CONNECTION_NAME="${CLOUDSQL_CONNECTION_NAME:-taggd-491107:asia-south1:tgddata-pg-dev2}"
export CLOUDSQL_DATABASE="${CLOUDSQL_DATABASE:-tgddata_dev2}"
export CLOUDSQL_USER="${CLOUDSQL_USER:-tgddata_app_dev2}"
export CLOUDSQL_SECRET_PASSWORD_DEV2="${CLOUDSQL_SECRET_PASSWORD_DEV2:-tgddata-pg-dev2-db-password}"
export CLOUDSQL_SECRET_DATABASE_URL_DEV2="${CLOUDSQL_SECRET_DATABASE_URL_DEV2:-TGDDATA_DATABASE_URL_DEV2}"

# New isolated GCS buckets
export GCS_UPLOADS_BUCKET="${GCS_UPLOADS_BUCKET:-taggd-tgddata-dev2-uploads}"
export GCS_WEB_BUCKET="${GCS_WEB_BUCKET:-taggd-tgddata-dev2-web}"

# New Cloud Run service
export CLOUD_RUN_SERVICE_API="${CLOUD_RUN_SERVICE_API:-tgddata-api-dev2}"

# Same Artifact Registry repo, dev2 image tag
export AR_REPO="${AR_REPO:-tgddata}"
export IMAGE_API="${IMAGE_API:-${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT}/${AR_REPO}/api:dev2}"

# Shared infra (read-only reuse)
export VPC_CONNECTOR="${VPC_CONNECTOR:-tgddata-run-connector}"
export RUNTIME_SA_NAME="${RUNTIME_SA_NAME:-tgddata-runtime}"
export RUNTIME_SA_EMAIL="${RUNTIME_SA_EMAIL:-tgddata-runtime@${GCP_PROJECT}.iam.gserviceaccount.com}"

export STORAGE_BACKEND="${STORAGE_BACKEND:-gcs}"
export STORAGE_PREFIX="${STORAGE_PREFIX:-tgddata-dev2}"
export APP_ENV="${APP_ENV:-development}"
export CORS_ALLOW_ORIGINS="${CORS_ALLOW_ORIGINS:-https://storage.googleapis.com}"

export PUBLIC_APP_URL="${PUBLIC_APP_URL:-https://storage.googleapis.com/${GCS_WEB_BUCKET}/app.html#/login}"
