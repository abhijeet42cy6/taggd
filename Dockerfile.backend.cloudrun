# Cloud Run / AWS App Runner / ECS — listens on $PORT (default 8080).
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y build-essential && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY ./backend /app/backend
COPY alembic.ini /app/alembic.ini
COPY alembic /app/alembic
COPY scripts/docker-entrypoint-backend.sh /app/docker-entrypoint-backend.sh
RUN chmod +x /app/docker-entrypoint-backend.sh

ENV PYTHONPATH=/app
ENV PORT=8080

EXPOSE 8080

ENTRYPOINT ["/app/docker-entrypoint-backend.sh"]
