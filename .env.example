# Copy to `.env` in the repo root (same folder as docker-compose.yml).
# Used by: Docker Compose variable substitution, local `uvicorn`, and agent `load_dotenv()`.
# Do not commit `.env`.

# Required for AI features (sheet ID, column mapping, logic generation, matchmaker, analysis agent)
GEMINI_API_KEY=

# JWT signing — use a long random string in production (must stay stable or all sessions invalidate)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=1440

# Optional: first admin user when the SQLite DB is empty (bootstrap runs once at startup)
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# Local SQLite when not using Docker (default matches local dev)
# DATABASE_URL=sqlite:///./revenue_generator.db

# Composio integration (Microsoft Teams / Outlook calendar)
# Keep these server-side only; do NOT expose as frontend secrets.
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_ENV=prod
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
# Optional public backend URL for OAuth callback generation (e.g. https://app.example.com)
COMPOSIO_PUBLIC_BASE_URL=
# Optional namespace prefix prepended to the user's email when registering with Composio.
# Leave empty (recommended) to send the raw login email as Composio `user_id`,
# which makes the connection clearly traceable in the Composio dashboard.
COMPOSIO_USER_ID_PREFIX=

# Frontend feature toggle only (safe to expose in browser bundle)
VITE_TEAMS_CALENDAR_ENABLED=true

# Optional: ngrok public tunnel (use with docker-compose.ngrok.yml). Token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
