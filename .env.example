# Copy to `.env` in the repo root (same folder as docker-compose.yml).
# Used by: Docker Compose variable substitution, local `uvicorn`, and agent `load_dotenv()`.
# Do not commit `.env`.

# ─── Local dev modes (pick one) ───────────────────────────────────────────────
# Local hot-reload dev (Postgres + Adminer + backend autoreload + frontend HMR):
#   ./scripts/start-dev-local.sh
#   ./scripts/start-dev-local.sh --fresh   # wipe local DB volume first
#   ./scripts/start-dev-local.sh --build   # rebuild images only when needed
#   App: http://127.0.0.1:8080/   Adminer: http://127.0.0.1:8081/
#   Adminer: System=PostgreSQL, Server=postgres, credentials below
#
# Stable image build path (slower, for release-like verification):
#   docker compose -f docker-compose.yml up -d --build
#
# GCP dev clone (tgddata_dev on tgddata-pg-prod-dev):
#   ./scripts/start-dev-cloudsql.sh
#
# Stop either stack:
#   ./scripts/start-dev-local.sh down
#   ./scripts/start-dev-cloudsql.sh down
#
# DATABASE_URL below is rewritten by the start scripts (marked block in .env).

# ─── PostgreSQL (local Docker — docker-compose.yml) ───────────────────────────
POSTGRES_USER=tgddata
POSTGRES_PASSWORD=tgddata_dev
POSTGRES_DB=tgddata

# --- DATABASE_URL (managed by start-dev-*.sh; do not edit) ---
# DB_MODE=local
# DATABASE_URL=postgresql+psycopg://tgddata:tgddata_dev@127.0.0.1:5432/tgddata
# --- end DATABASE_URL ---

# Google Cloud SQL (tgddata-pg-prod) — generate on VM with: ./scripts/fetch-cloudsql-database-url.sh
CLOUDSQL_CONNECTION_NAME=taggd-491107:asia-south1:tgddata-pg-prod
# DATABASE_URL=postgresql+psycopg://tgddata_app:PASSWORD@/tgddata?host=/cloudsql/taggd-491107:asia-south1:tgddata-pg-prod

# ─── Dev clone (tgddata_dev on tgddata-pg-prod-dev) — local testing only ───
# Does NOT touch production Cloud Run, GCS, or tgddata-pg-prod data.
# Refresh dev data from prod (read-only dump): ./scripts/clone-prod-to-dev-cloudsql.sh
CLOUDSQL_CONNECTION_NAME_DEV=taggd-491107:asia-south1:tgddata-pg-prod-dev
# DATABASE_URL=postgresql+psycopg://tgddata_app:PASSWORD@/tgddata_dev?host=/cloudsql/taggd-491107:asia-south1:tgddata-pg-prod-dev&sslmode=disable
#
# Prod deploy (proxy in Docker): docker compose -f docker-compose.prod.yml up -d --build
# Prod deploy (host systemd proxy): docker compose -f docker-compose.prod.host-proxy.yml up -d --build

# ─── Cloud Run / enterprise (API container) ───────────────────────────────────
# APP_ENV=production
# PORT=8080
# STORAGE_BACKEND=gcs
# STORAGE_BUCKET=your-gcs-bucket
# STORAGE_PREFIX=tgddata
# CORS_ALLOW_ORIGINS=https://taggd.aparatus.in
# Frontend build (Cloud Run): VITE_API_BASE_URL=https://your-api.run.app  (no /api suffix)
# Frontend build (VM nginx):  VITE_API_BASE_URL=/api

# AWS equivalent:
# STORAGE_BACKEND=s3
# AWS_REGION=ap-south-1

# AWS RDS PostgreSQL, example:
# DATABASE_URL=postgresql+psycopg://APP_USER:PASSWORD@your-instance.region.rds.amazonaws.com:5432/tgddata?sslmode=require

# One-time SQLite → Postgres data copy (source file on your machine):
# SQLITE_SOURCE_PATH=/Users/arjun/Software/tagged_data_sql/revenue_generator.db
# python -m backend.scripts.migrate_sqlite_to_postgres --truncate

# Required for AI features (sheet ID, column mapping, logic generation, matchmaker, analysis agent)
GEMINI_API_KEY=

# JWT signing — use a long random string in production (must stay stable or all sessions invalidate)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=1440

# Optional: first admin user when the users table is empty (bootstrap runs once at startup)
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# Composio integration (Microsoft Teams / Outlook calendar)
# Keep these server-side only; do NOT expose as frontend secrets.
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_ENV=prod
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
# Optional public backend URL for OAuth callback generation (e.g. https://app.example.com)
COMPOSIO_PUBLIC_BASE_URL=
COMPOSIO_USER_ID_PREFIX=

# Frontend feature toggle only (safe to expose in browser bundle)
VITE_TEAMS_CALENDAR_ENABLED=true

# Optional: ngrok public tunnel (use with docker-compose.ngrok.yml)
NGROK_AUTHTOKEN=
