# Backend Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements or install directly for simplicity since we have the list
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    sqlalchemy \
    pandas \
    openpyxl \
    python-dotenv \
    google-generativeai \
    instructor \
    python-multipart \
    pydantic-settings

# Copy the backend code
COPY ./backend /app/backend
COPY .env /app/.env

# Create data directory for SQLite and Excel uploads
RUN mkdir -p /app/data

# Set Environment Variables
ENV PYTHONPATH=/app
ENV GEMINI_API_KEY=AIzaSyAFTKtEL5QL2xp1wrP63z8m7BvgmQ4Ci0c

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
