# Backend Dockerfile — secrets via docker-compose environment / .env (never bake keys into the image)
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY ./backend /app/backend
COPY alembic.ini /app/alembic.ini
COPY alembic /app/alembic
COPY scripts/docker-entrypoint-backend.sh /app/docker-entrypoint-backend.sh
RUN chmod +x /app/docker-entrypoint-backend.sh

RUN mkdir -p /app/data

ENV PYTHONPATH=/app

EXPOSE 8000

ENTRYPOINT ["/app/docker-entrypoint-backend.sh"]
